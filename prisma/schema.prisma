generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING_PAYMENT
  WAITING_VERIFICATION
  PAYMENT_REJECTED
  PAYMENT_APPROVED
  PRODUCT_SENT
  COMPLETED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum MessageSenderType {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum MessageKind {
  TEXT
  SYSTEM
  DOWNLOAD
  ATTACHMENT
}

enum NotificationType {
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  PAYMENT_PROOF_REQUIRED
  PRODUCT_SENT
  ORDER_COMPLETED
  NEW_MESSAGE
}

enum AccountRole {
  CUSTOMER
  ADMIN
  SUPERADMIN
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  imageUrl    String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String           @id @default(uuid())
  name           String
  slug           String           @unique
  status         String           @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  description    String           @db.LongText
  price          Int // Minor integer unit (IDR)
  salePrice      Int? // Discounted price (IDR)
  license        String           @default("Personal License")
  downloadPolicy String           @default("7_DAYS_5_DOWNLOADS")
  isFeatured     Boolean          @default(false)
  /// Position in the homepage hero collage. Lower sorts first; the storefront
  /// takes the first three published featured products by this value.
  heroOrder      Int              @default(0)
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  media          ProductMedia[]
  versions       ProductVersion[]
  orderItems     OrderItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, isFeatured, heroOrder])
}

model ProductMedia {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String   @default("IMAGE") // IMAGE, VIDEO
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model FileAsset {
  id           String              @id @default(uuid())
  originalName String
  storageKey   String              @unique
  mimeType     String
  size         Int
  hash         String?
  isPrivate    Boolean             @default(true)
  versions     ProductVersion[]
  proofs       PaymentProof[]
  entitlements Entitlement[]       @relation("EntitlementFileAsset")
  attachments  MessageAttachment[]
  createdAt    DateTime            @default(now())
}

model ProductVersion {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  version     String    @default("1.0.0")
  fileId      String
  fileAsset   FileAsset @relation(fields: [fileId], references: [id])
  changelog   String?   @db.Text
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
}

model Order {
  id               String         @id @default(uuid())
  invoice          String         @unique // INV-YYYYMMDD-XXXX
  status           OrderStatus    @default(PENDING_PAYMENT)
  customerAccessId String
  customerAccess   CustomerAccess @relation(fields: [customerAccessId], references: [id])

  customerName     String
  customerEmail    String
  customerWhatsapp String

  subtotal     Int
  discount     Int @default(0)
  uniqueAmount Int @default(0)
  total        Int

  couponCode String?

  idempotencyKey  String? @unique
  secureTokenHash String // SHA256 of raw secret tracking token

  expiresAt       DateTime
  rejectionReason String?  @db.Text
  internalNote    String?  @db.Text
  deliveryNote    String?  @db.Text

  paymentProofSubmittedAt DateTime?
  paymentApprovedAt       DateTime?
  paymentRejectedAt       DateTime?
  productSentAt           DateTime?
  completedAt             DateTime?

  items         OrderItem[]
  proofs        PaymentProof[]
  entitlements  Entitlement[]
  couponUsages  CouponUsage[]
  conversation  Conversation?
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerAccessId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id              String       @id @default(uuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product      @relation(fields: [productId], references: [id])
  productName     String
  unitPrice       Int
  quantity        Int          @default(1)
  license         String
  versionPolicy   String       @default("CURRENT")
  productSnapshot String       @db.LongText // JSON stringified snapshot
  entitlement     Entitlement?
  createdAt       DateTime     @default(now())
}

model PaymentProof {
  id              String    @id @default(uuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileId          String
  fileAsset       FileAsset @relation(fields: [fileId], references: [id])
  senderName      String
  amount          Int
  paidAt          DateTime
  note            String?   @db.Text
  fileHash        String?
  status          String    @default("ACTIVE") // ACTIVE, SUPERSEDED, REJECTED
  rejectionReason String?   @db.Text
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
}

model Entitlement {
  id            String          @id @default(uuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId   String          @unique
  orderItem     OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  fileAssetId   String?
  fileAsset     FileAsset?      @relation("EntitlementFileAsset", fields: [fileAssetId], references: [id])
  tokenHash     String          @unique // SHA256 hash of download access token
  expiresAt     DateTime
  maxDownloads  Int             @default(5)
  downloadCount Int             @default(0)
  revokedAt     DateTime?
  downloads     DownloadEvent[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([fileAssetId])
}

model DownloadEvent {
  id            String      @id @default(uuid())
  entitlementId String
  entitlement   Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  ipHash        String
  userAgent     String
  result        String      @default("ALLOWED") // ALLOWED, EXPIRED, LIMIT_REACHED, REVOKED, INVALID_TOKEN
  timestamp     DateTime    @default(now())
}

model Coupon {
  id            String        @id @default(uuid())
  code          String        @unique
  type          String        @default("PERCENTAGE") // PERCENTAGE, FIXED
  value         Int // Percentage (1-100) or Fixed IDR amount
  minPurchase   Int           @default(0)
  maxUsage      Int           @default(100)
  currentUsage  Int           @default(0)
  perEmailLimit Int           @default(1)
  startsAt      DateTime      @default(now())
  endsAt        DateTime
  isActive      Boolean       @default(true)
  usages        CouponUsage[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model CouponUsage {
  id            String   @id @default(uuid())
  couponId      String
  coupon        Coupon   @relation(fields: [couponId], references: [id])
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  customerEmail String
  createdAt     DateTime @default(now())
}

model AdminUser {
  id               String     @id @default(uuid())
  name             String
  email            String     @unique
  twoFactorEnabled Boolean    @default(false)
  status           String     @default("ACTIVE")
  account          Account?
  auditLogs        AuditLog[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model AuditLog {
  id          String     @id @default(uuid())
  actorId     String?
  actor       AdminUser? @relation(fields: [actorId], references: [id])
  actorEmail  String
  action      String
  entity      String
  entityId    String?
  detailsJson String?    @db.LongText
  ipAddress   String?
  createdAt   DateTime   @default(now())
}

/// Legacy outbound notification queue retained so existing SQLite rows can be
/// imported without being discarded. It is intentionally unused by the new
/// in-app notification center (email delivery is out of scope for this phase).
model OutboundNotification {
  id          String    @id @default(uuid())
  recipient   String
  channel     String    @default("EMAIL") // EMAIL, DASHBOARD
  template    String
  status      String    @default("PENDING") // PENDING, SENT, FAILED
  retries     Int       @default(0)
  payloadJson String    @db.LongText
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
}

/// Anonymous customer identity backed by a signed, HttpOnly browser session.
/// No raw access token is persisted in the database.
model CustomerAccess {
  id              String         @id @default(uuid())
  emailNormalized String
  displayName     String
  whatsapp        String?
  account         Account?
  orders          Order[]
  conversations   Conversation[]
  notifications   Notification[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([emailNormalized, createdAt])
}

/// Shared credential record for customer and admin identities. The legacy physical
/// table name is retained so existing local data can be upgraded without a table copy.
model Account {
  id               String          @id @default(uuid())
  emailNormalized  String          @unique
  passwordHash     String
  role             AccountRole     @default(CUSTOMER)
  customerAccessId String?         @unique
  customerAccess   CustomerAccess? @relation(fields: [customerAccessId], references: [id], onDelete: Cascade)
  adminUserId      String?         @unique
  adminUser        AdminUser?      @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  lastLoginAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([lastLoginAt])
  @@index([role])
  @@map("CustomerAccount")
}

model Conversation {
  id               String         @id @default(uuid())
  orderId          String         @unique
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerAccessId String
  customerAccess   CustomerAccess @relation(fields: [customerAccessId], references: [id], onDelete: Cascade)
  messages         Message[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([customerAccessId, updatedAt])
  @@index([updatedAt])
}

model Message {
  id             String              @id @default(uuid())
  conversationId String
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     MessageSenderType
  senderId       String?
  kind           MessageKind         @default(TEXT)
  body           String              @db.Text
  actionLabel    String?
  actionUrl      String?             @db.VarChar(2048)
  dedupeKey      String?             @unique
  readAt         DateTime?
  attachments    MessageAttachment[]
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@index([senderType, readAt])
}

model MessageAttachment {
  id        String    @id @default(uuid())
  messageId String
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileId    String
  fileAsset FileAsset @relation(fields: [fileId], references: [id])
  createdAt DateTime  @default(now())

  @@index([messageId])
  @@index([fileId])
}

model Notification {
  id               String           @id @default(uuid())
  customerAccessId String
  customerAccess   CustomerAccess   @relation(fields: [customerAccessId], references: [id], onDelete: Cascade)
  orderId          String?
  order            Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type             NotificationType
  title            String
  body             String           @db.Text
  actionUrl        String?          @db.VarChar(2048)
  dedupeKey        String?          @unique
  readAt           DateTime?
  createdAt        DateTime         @default(now())

  @@index([customerAccessId, createdAt])
  @@index([customerAccessId, readAt])
  @@index([orderId])
}

model StoreSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text // Stringified value or JSON
  updatedAt DateTime @updatedAt
}

/// Editorial content for the homepage hero. Only one row should be active at a
/// time; the storefront reads the newest active row and falls back to a static
/// copy of this content when the database is unreachable.
model HeroContent {
  id                String   @id @default(uuid())
  eyebrow           String
  /// First headline line, rendered upright above the italic line.
  headlineLead      String
  /// Second headline line, rendered italic.
  headlineItalic    String
  /// Serif italic line under the headline.
  subtitle          String
  description       String   @db.Text
  primaryCtaLabel   String
  primaryCtaUrl     String
  secondaryCtaLabel String
  secondaryCtaUrl   String
  imageUrl          String
  imageAlt          String   @default("")
  collectionLabel   String
  collectionValue   String
  formatLabel       String
  formatValue       String
  licenseLabel      String
  licenseValue      String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive])
}
