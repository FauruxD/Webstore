# Database (MySQL 8; matches docker-compose.yml)
DATABASE_URL="mysql://digital_atelier:password@localhost:3306/digital_atelier"

# Shared account authentication (role: CUSTOMER | ADMIN | SUPERADMIN)
ADMIN_JWT_SECRET="super-secret-admin-jwt-token-key-change-in-production-12345"
ADMIN_SESSION_COOKIE="webstore_admin_session"
DEFAULT_ADMIN_EMAIL="admin@webstore.local"
DEFAULT_ADMIN_PASSWORD="AdminSecret123!"

# Customer and guest access (use at least 32 random bytes in production)
CUSTOMER_SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-bytes"
CUSTOMER_SESSION_COOKIE="digital_atelier_customer"
DEFAULT_CUSTOMER_EMAIL="buyer@webstore.local"
DEFAULT_CUSTOMER_PASSWORD="BuyerSecret123!"

# Private upload storage (the current driver is local filesystem only).
# In production, mount LOCAL_STORAGE_PATH to a persistent volume.
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./storage/private"

# Email Driver (console | resend)
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="Webstore Produk Digital <noreply@webstore.local>"

# Canonical public URL for integrations that may need it. Replace localhost in production.
# Authentication redirects remain same-origin and do not depend on this value.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# App Branding
NEXT_PUBLIC_STORE_NAME="Digital Atelier"
NEXT_PUBLIC_MERCHANT_NAME="FA RUX DIGITAL STORE"
